# AKL Revival release archive exclusions
# These files remain in Git but are excluded from git archive.

/.build/** export-ignore
/.github/** export-ignore
/tests/** export-ignore
/.flake8 export-ignore
/.gitignore export-ignore
/GitVersion.yml export-ignore
/pytest.ini export-ignore
/requirements.txt export-ignore

# Original upstream artwork; Revival artwork is packaged instead.
/media/icon.png export-ignore
/media/fanart.jpg export-ignore

# Development backups and temporary files.
*.bak export-ignore
*.pyc export-ignore
*.pyo export-ignore
*.log export-ignore
**/__pycache__/** export-ignore
**/.pytest_cache/** export-ignore

# Exclude archive configuration itself.
/.gitattributes export-ignore
